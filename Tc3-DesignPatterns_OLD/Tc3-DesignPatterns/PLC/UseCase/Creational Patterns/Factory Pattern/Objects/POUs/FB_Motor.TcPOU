]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_Status" Id="{0f503500-5690-4122-a899-5aa257fc48d9}">
      <Declaration><![CDATA[{warning 'add property implementation'}
PROPERTY P_Status : DWORD
]]></Declaration>
      <Get Name="Get" Id="{47b53e07-f8c9-45b2-bd9a-65821a5dfee4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="pInstance" Id="{b495c143-1c4f-44f3-84ed-ccd96d6a5ffc}">
      <Declaration><![CDATA[PROPERTY pInstance : POINTER TO FB_EmptyObject]]></Declaration>
      <Set Name="Set" Id="{0aee5ea9-193d-4678-a451-6df8650e98e4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// Store pointer for destructor
_pInstance := pInstance;]]></ST>
        </Implementation>
      </Set>
    </Property>
